# One key per line — numbers need not be contiguous. No tier declaration
# needed: at startup each key's real plan is read live from Tavily's own
# GET /usage (current_plan) — free keys are always tried first, a paid
# (pay-as-you-go) key is only ever used once every free key is exhausted.
# See .claude/specs/tavily-search-key-rotation.md.
TAVILY_API_KEY_1=tvly-your_api_key_here
# TAVILY_API_KEY_2=tvly-...

# Real ceiling on concurrent calls to the actual Tavily API, across all keys, and the
# ceiling per key. Tavily limits a development key to 100 requests/min (429 above it); a
# small steady flow beats a big one with retry storms (see src/config.py).
MAX_CONCURRENT=10
PER_KEY_CONCURRENCY=1

# Pool-wide cap on upstream calls per minute (every attempt counts) and the pause every
# caller takes after a 429 that sent no Retry-After. See src/limiter.py.
MAX_REQUESTS_PER_MINUTE=60
RATE_LIMIT_PAUSE_SECONDS=30

LOG_LEVEL=INFO
